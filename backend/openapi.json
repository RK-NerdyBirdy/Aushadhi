{
  "openapi": "3.1.0",
  "info": {
    "title": "Hospital Drug Inventory Management System",
    "description": "AI-powered drug inventory optimization using demand prediction and clustering",
    "version": "1.0.0"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "authentication"
        ],
        "summary": "Login",
        "description": "Authenticate user and return JWT token.\nWorks for both hospital and vendor users.\n\n**Request Body:**\n- `user_email`: User email address\n- `user_password`: User password\n\n**Returns:**\n- `access_token`: JWT token for authenticated requests\n- `token_type`: Bearer token type\n- `user_id`: User identifier\n- `user_name`: User name\n- `organization_id`: Hospital/Vendor/Organization ID\n- `user_role`: User role (hospital_admin, hospital_staff, vendor_admin, vendor_staff)",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserLogin"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "authentication"
        ],
        "summary": "Get Current User Info",
        "description": "Get current logged-in user details.\nWorks for both hospital and vendor users.\n\n**Headers:**\n- `Authorization: Bearer \u003Ctoken\u003E`\n\n**Returns:**\n- User details with organization information",
        "operationId": "get_current_user_info_api_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/hospital/upload_stock": {
      "post": {
        "tags": [
          "data upload"
        ],
        "summary": "Upload Stock",
        "description": "Upload current stock data via CSV file (Hospital users only).\n\n**Authentication:** Requires hospital_admin or hospital_staff role\n\n**CSV Format:**\n```\nmedicine_id,medicine_name,medicine_quantity,medicine_expiry\nMED001,Paracetamol 500mg,5000,2025-12-31\n```\n\n**Returns:**\n- `message`: Success/error message\n- `records_processed`: Total rows processed\n- `records_inserted`: New records added\n- `records_updated`: Existing records updated\n- `errors`: List of errors (if any)",
        "operationId": "upload_stock_api_hospital_upload_stock_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_stock_api_hospital_upload_stock_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockUploadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/hospital/upload_usage": {
      "post": {
        "tags": [
          "data upload"
        ],
        "summary": "Upload Usage",
        "description": "Upload historical usage data via CSV file (Hospital users only).\n\n**Authentication:** Requires hospital_admin or hospital_staff role\n\n**CSV Format:**\n```\nusage_date,medicine_id,medicine_name,quantity_consumed,department\n2024-01-15,MED001,Paracetamol 500mg,350,Outpatient\n```\n\n**Returns:**\n- `message`: Success/error message\n- `records_processed`: Total rows processed\n- `records_inserted`: New records added\n- `date_range`: Start and end dates of data\n- `errors`: List of errors (if any)",
        "operationId": "upload_usage_api_hospital_upload_usage_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_usage_api_hospital_upload_usage_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockUploadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/hospital/calculate-predictions": {
      "post": {
        "tags": [
          "predictions"
        ],
        "summary": "Calculate Predictions",
        "description": "Calculate X1, X2, X3, X4 and inventory parameters for all medicines (Hospital users only).\n\n**Authentication:** Requires hospital_admin or hospital_staff role\n\n**Implementation Steps:**\n1. Fetch stock and usage data from database\n2. Calculate X1_AMC (Average Monthly Consumption)\n3. Calculate X2_Prescriptions (Monthly average prescriptions)\n4. Calculate X3_CDPR (Chronic Disease Prescription Ratio)\n5. Calculate X4_CV (Coefficient of Variation)\n6. Apply K-Means clustering (4 clusters)\n7. Calculate (s, S) inventory parameters\n8. Save predictions to database",
        "operationId": "calculate_predictions_api_hospital_calculate_predictions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/hospital/predictions": {
      "get": {
        "tags": [
          "predictions"
        ],
        "summary": "Get Predictions",
        "description": "Retrieve calculated predictions with filters (Hospital users only).\n\n**Authentication:** Requires hospital_admin or hospital_staff role\n\n**Query Parameters:**\n- `cluster_group`: Filter by cluster (1, 2, 3, or 4)\n- `low_stock_only`: Boolean - show only items below reorder point\n- `page`: Page number (default: 1)\n- `limit`: Items per page (default: 50)",
        "operationId": "get_predictions_api_hospital_predictions_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "cluster_group",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "Filter by cluster group (1-4)",
              "title": "Cluster Group"
            },
            "description": "Filter by cluster group (1-4)"
          },
          {
            "name": "low_stock_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Show only items below reorder point",
              "default": false,
              "title": "Low Stock Only"
            },
            "description": "Show only items below reorder point"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionsListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
